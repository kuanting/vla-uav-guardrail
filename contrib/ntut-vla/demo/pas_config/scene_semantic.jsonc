// Scene for the semantic / follow-the-car missions. Same world and spawn as
// scene_guardrail.jsonc, but with the lightweight camera loadout.
{
  "id": "SceneSemanticDemo",
  "actors": [
    {
      "type": "robot",
      "name": "Drone1",
      "origin": {
        "xyz": "35.0 -20.0 -2.0",
        "rpy-deg": "0 0 0"
      },
      "robot-config": "robot_semantic_quad.jsonc"
    }
  ],
  // The subject vehicle, moved by a trajectory the simulator interpolates
  // rather than by one teleport per control tick. See env_actor_car.jsonc for
  // why, and docs/FINDING-scene-motion-belongs-to-the-simulator.md for the
  // measurements. The origin is a parking spot off the demo route; the real
  // route is uploaded at flight start.
  //
  // The origin is ZERO deliberately. An imported trajectory carries absolute
  // NED positions, and the actor's origin is applied on top of them, so a
  // non-zero origin here shifts the whole route by that much. With the origin
  // at the route's own start (38, -8) the car drove a path offset by exactly
  // that, and the aircraft - which follows what the camera sees while the
  // metrics measure against the intended path - reported a mean separation of
  // 69 m and a hit rate of 0.226.
  "environment-actors": [
    {
      "type": "env_actor",
      "name": "SemCarActor",
      "origin": {
        "xyz": "0.0 0.0 0.0",
        "rpy-deg": "0 0 0"
      },
      "env-actor-config": "env_actor_car.jsonc"
    }
  ],
  "clock": {
    "type": "steppable",
    "step-ns": 3000000,
    "real-time-update-rate": 3000000,
    "pause-on-start": false
  },
  "home-geo-point": {
    "latitude": 35.6895,
    "longitude": 139.6917,
    "altitude": 40.0
  },
  "segmentation": {
    "initialize-ids": false,
    "ignore-existing": false,
    "use-owner-name": true
  },
  "scene-type": "UnrealNative"
}
