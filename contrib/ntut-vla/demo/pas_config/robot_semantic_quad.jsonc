  "joints": [
    {
      "id": "Frame_Prop_FL",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_FR",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_RL",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_RL",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_RR",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_RR",
      "axis": "0 0 1"
    }
  ],
  "controller": {
    "id": "Simple_Flight_Controller",
    "airframe-setup": "quadrotor-x",
    "type": "simple-flight-api",
    "simple-flight-api-settings": {
      "actuator-order": [
        {
          "id": "Prop_FR_actuator"
        },
        {
          "id": "Prop_RL_actuator"
        },
        {
          "id": "Prop_FL_actuator"
        },
        {
          "id": "Prop_RR_actuator"
        }
      ]
    }
  },
  "actuators": [
    {
      "name": "Prop_FL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "origin": {
        "xyz": "0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_FR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      "origin": {
        "xyz": "0.253 0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_RL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RL",
      "origin": {
        "xyz": "-0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_RR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RR",
      "origin": {
        "xyz": "-0.253 0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    }
  ],
  "sensors": [
    {
      "id": "FrontCamera",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.1,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 400,
          "height": 225,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": false,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        },
        // DEPTH_PERSPECTIVE (2), not DEPTH_PLANAR (1). Planar depth measures
        // along the optical axis, so an off-axis target reads nearer than it is
        // by cos(bearing); perspective depth is the true radial distance, which
        // is what a range signal has to be.
        //
        // Same 400x225 and same 90 deg FOV as the Scene capture ON PURPOSE: the
        // detection box comes from the Scene image and is used to index straight
        // into this one, so any mismatch in resolution or field of view would
        // silently sample the wrong pixels.
        //
        // This was previously removed as "rendered for nothing", which was true
        // while the controller had no use for range. It has one now: the orbit
        // radial servo used apparent box width, which swings by root-2 on a
        // square building between face-on and corner-on and spiralled the radius
        // from 37.7 m to 178 m. See docs/DESIGN-orbit-building-task.md.
        // "streaming-enabled": true is LOAD-BEARING here, and it is the one
        // thing the shipped reference config gets away with omitting.
        //
        // With it false the topic still appears in the subscribe list and frames
        // still arrive on schedule — they are simply all zeros. Nothing errors,
        // nothing warns, and range_from_depth quietly returns None on every
        // tick, so the controller silently falls back to the width servo and the
        // orbit fails in exactly the way it failed without any depth at all.
        // Measured: 0 of 90000 non-zero with streaming off, 34824 of 90000 with
        // it on. Do not "tidy" this back to false.
        //
        // "pixels-as-float": true is requested and IGNORED — the sim publishes
        // 16UC1 either way, i.e. uint16 metres with 0 meaning no hit and 65504
        // the far sentinel. SemanticObs.get_depth() already decodes that, and
        // range_from_depth filters both sentinels. The cost is 1 m of range
        // resolution, which is fine against a 41 m orbit radius.
        // ONE depth capture, not two. Both DEPTH_PLANAR (1) and
        // DEPTH_PERSPECTIVE (2) were enabled while working out which one the sim
        // would actually populate; only perspective is used, and leaving planar
        // on cost a second full render target every 0.1 s on the same GPU that
        // runs the detector and draws the viewport. The game window came up
        // BLANK WHITE with both enabled.
        {
          "image-type": 2,
          "width": 400,
          "height": 225,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": true,
          "compress": false
        }
      ],
      "origin": {
        "xyz": "0.3 0.0 0.0",
        "rpy-deg": "0 -20.0 0"
      }
    },
    {
      "id": "Chase",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      // 20 Hz, and 960x540. This camera is what the DEMO VIDEO and the
      // simulator window show; it is NOT the detector's input.
      //
      // It was 1280x720 and the comment here claimed that, since this is not
      // the detector's camera, a bigger capture "costs GPU but changes no
      // measurement". That was wrong and the measurement disproved it: at
      // 1280x720 the detector fell to det_hz 2.94-3.96 (gate is 4.0) and the
      // control loop to 7.50-8.69 Hz (gate is 9.5). A flight recorded with the
      // recorder writing ZERO frames still reached only 8.16 Hz, so roughly
      // 1.8 Hz of the loss is this camera's render and deserialisation cost,
      // not Python. The panels share one GPU; a bigger Chase capture starves
      // the detector, and a slower detector tracks a moving car worse.
      //
      // 960x540 is the first rung of a back-off ladder fixed before the runs
      // (960x540@20 -> 1280x720@15 -> 960x540@15).
      // FrontCamera stays 400x225: it IS the detector's input, and every
      // measured number in this repo depends on it.
      "capture-interval": 0.05,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 960,
          "height": 540,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        }
      ],
      "gimbal": {
        "lock-roll": true,
        "lock-pitch": true,
        "lock-yaw": false
      },
      "origin": {
        "xyz": "-16.0 0.0 -7.0",
        "rpy-deg": "0 -22 0"
      }
    },
    {
      "id": "DownCamera",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.5,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 400,
          "height": 225,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": false,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        }
      ],
      "noise-settings": [
        {
          "enabled": false,
          "image-type": 1,
          "rand-contrib": 0.2,
          "rand-speed": 100000.0,
          "rand-size": 500.0,
          "rand-density": 2,
          "horz-wave-contrib": 0.03,
          "horz-wave-strength": 0.08,
          "horz-wave-vert-size": 1.0,
          "horz-wave-screen-size": 1.0,
          "horz-noise-lines-contrib": 1.0,
          "horz-noise-lines-density-y": 0.01,
          "horz-noise-lines-density-xy": 0.5,
          "horz-distortion-contrib": 1.0,
          "horz-distortion-strength": 0.002
        }
      ],
      "origin": {
        "xyz": "0 0.0 0.0",
        "rpy-deg": "0 -90 0"
      }
    },
    {
      "id": "IMU1",
      "type": "imu",
      "enabled": true,
      "parent-link": "Frame",
      "accelerometer": {
        "velocity-random-walk": 0.002353,
        "tau": 800,
        "bias-stability": 0.000353,
        "turn-on-bias": "0 0 0"
      },
      "gyroscope": {
        "angle-random-walk": 8.72644e-05,
        "tau": 500,
        "bias-stability": 2.23014e-05,
        "turn-on-bias": "0 0 0"
      }
    },
    {
      "id": "GPS",
      "type": "gps",
      "enabled": false,
      "parent-link": "Frame"
    },
    {
      "id": "Barometer",
      "type": "barometer",
      "enabled": false,
      "parent-link": "Frame"
    },
    {
      "id": "Magnetometer",
      "type": "magnetometer",
      "enabled": false,
      "parent-link": "Frame"
    }
  ]
}
